<style>
:root{
  --ink:#14213d;
  --muted:#5e6b7e;
  --line:#e5eaf1;
  --bg:#f7f9fc;
  --card:#ffffff;
  --accent:#5b4bdb;
  --accent2:#7c6ff0;
