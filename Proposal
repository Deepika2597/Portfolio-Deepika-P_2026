}
a{text-decoration:none;color:inherit}
.container{width:min(1120px,92%);margin:auto}
nav{
  position:sticky;top:0;z-index:10;
  background:rgba(255,255,255,.94);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--line);
}
.nav-inner{height:72px;display:flex;align-items:center;justify-content:space-between}
.logo{font-weight:800;letter-spacing:-.4px}
.logo span{color:var(--accent)}
.nav-links{display:flex;gap:25px;font-size:14px;color:var(--muted)}
.nav-links a:hover{color:var(--accent)}
.hero{
  background:
    radial-gradient(circle at 85% 20%, rgba(124,111,240,.20), transparent 30%),
    linear-gradient(135deg,#fff 0%,#f5f3ff 100%);
  padding:95px 0 85px;
}
.hero-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:55px;align-items:center}
.eyebrow{
  display:inline-block;padding:7px 12px;border-radius:999px;
  background:var(--soft);color:var(--accent);font-size:12px;font-weight:800;
  text-transform:uppercase;letter-spacing:.8px
}
h1{font-size:clamp(46px,7vw,78px);line-height:1.02;letter-spacing:-3.5px;margin:18px 0 18px}
.hero h2{font-size:23px;margin:0 0 18px;color:#334155;font-weight:600}
.lead{font-size:18px;color:var(--muted);max-width:700px}
.buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.btn{padding:13px 20px;border-radius:10px;font-weight:750;font-size:14px;border:1px solid var(--line);background:#fff}
.btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.btn:hover{transform:translateY(-1px)}
.profile-card{
  background:var(--dark);color:white;border-radius:24px;padding:30px;
  box-shadow:0 20px 60px rgba(16,24,40,.16)
}
.profile-card .initials{
  width:80px;height:80px;border-radius:20px;background:#fff;color:var(--accent);
  display:grid;place-items:center;font-size:27px;font-weight:850;margin-bottom:25px
}
.profile-card h3{margin:0;font-size:24px}
.profile-card p{color:#cbd5e1;margin:7px 0 25px}
.stat{padding:15px 0;border-top:1px solid rgba(255,255,255,.14);display:flex;justify-content:space-between}
.stat strong{font-size:18px}.stat span{color:#cbd5e1;font-size:13px}
section{padding:82px 0}
.section-label{color:var(--accent);font-weight:800;font-size:12px;text-transform:uppercase;letter-spacing:1.2px}
h2.section-title{font-size:38px;line-height:1.15;letter-spacing:-1.3px;margin:10px 0 14px}
.section-intro{color:var(--muted);max-width:760px}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.card{
  background:var(--card);border:1px solid var(--line);border-radius:18px;padding:28px;
}
.card h3{margin-top:0;font-size:20px}
.timeline{position:relative;margin-top:38px}
.timeline-item{display:grid;grid-template-columns:180px 1fr;gap:35px;padding:0 0 45px}
.timeline-year{font-weight:800;color:var(--accent)}
.timeline-content{border-left:2px solid #ddd9ff;padding-left:28px}
.timeline-content h3{margin:0 0 3px;font-size:24px}
.company{font-weight:700;color:#475569;margin-bottom:14px}
ul{padding-left:20px}li{margin:8px 0;color:#536174}
.portfolio-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:35px}
.sample{min-height:255px}
.icon{width:45px;height:45px;border-radius:12px;background:var(--soft);color:var(--accent);display:grid;place-items:center;font-weight:900;margin-bottom:20px}
.sample p{color:var(--muted);font-size:14px}
.sample-link{color:var(--accent);font-weight:800;font-size:14px}
.workflow{
  display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:32px
}
.step{background:#fff;border:1px solid var(--line);padding:18px 12px;border-radius:14px;text-align:center;font-weight:750;font-size:14px}
.step:not(:last-child)::after{content:"→";position:absolute}
.code{
  background:#101828;color:#dbeafe;border-radius:16px;padding:25px;
  overflow:auto;font:13px/1.7 ui-monospace,SFMono-Regular,Menlo,monospace
}
.align-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:30px}
.align{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px}
.align strong{display:block;margin-bottom:5px}.align span{color:var(--muted);font-size:14px}
.skills{display:flex;flex-wrap:wrap;gap:10px;margin-top:25px}
.skill{padding:9px 13px;border-radius:999px;background:#fff;border:1px solid var(--line);font-size:13px;font-weight:650}
.cta{
  background:var(--dark);color:white;border-radius:24px;padding:50px;
  display:flex;align-items:center;justify-content:space-between;gap:30px
