.cta p{color:#cbd5e1;max-width:620px}
footer{padding:30px 0;color:#718096;font-size:13px;text-align:center}
@media(max-width:850px){
 .hero-grid,.about-grid,.align-grid{grid-template-columns:1fr}
 .portfolio-grid{grid-template-columns:1fr}
 .timeline-item{grid-template-columns:1fr;gap:8px}
 .timeline-content{padding-left:18px}
 .workflow{grid-template-columns:1fr}
 .nav-links{display:none}
 h1{letter-spacing:-2px}
 .cta{display:block;padding:35px 25px}
}
</style>
</head>
